                        "Properties": {
                            "audience": {
                                "Description": "Value for the \"aud\" claim.",
                                "Optional": true,
                                "Type": "TypeString"
                            },
                            "issuer": {
                                "Description": "Value for the \"iss\" claim.",
                                "Optional": true,
                                "Type": "TypeString"
                            },
                            "subject": {
                                "Description": "Value for the \"sub\" claim.",
                                "Optional": true,
                                "Type": "TypeString"
                            }
                        },
                        "Type": "TypeList"
                    }
                },
                "Type": "TypeList"
            },
            "ssh_public_key": {
                "Description": "SSH Public Key for Authentication.",
                "ExactlyOneOf": "auth_config.0.user_password, auth_config.0.oauth2_jwt_bearer, auth_config.0.oauth2_client_credentials, auth_config.0.ssh_public_key, auth_config.0.oauth2_auth_code_flow",
                "MaxItems": 1,
                "Optional": true,
                "Properties": {
                    "cert_type": {
                        "Description": "Format of SSH Client cert.",
                        "Optional": true,
                        "Type": "TypeString"
                    },
                    "ssh_client_cert": {
                        "Description": "SSH Client Cert. It should contain both public and private key.",
                        "MaxItems": 1,
                        "Optional": true,
                        "Properties": {
                            "secret_version": {
                                "Description": "The resource name of the secret version in the format,\nformat as: projects/*/secrets/*/versions/*.",
                                "Required": true,
                                "Type": "TypeString"
                            }
                        },
                        "Type": "TypeList"
                    },
                    "ssh_client_cert_pass": {
                        "Description": "Password (passphrase) for ssh client certificate if it has one.",
                        "MaxItems": 1,
                        "Optional": true,
                        "Properties": {
                            "secret_version": {
                                "Description": "The resource name of the secret version in the format,\nformat as: projects/*/secrets/*/versions/*.",
                                "Required": true,
                                "Type": "TypeString"
                            }
                        },
                        "Type": "TypeList"
                    },
                    "username": {
                        "Description": "The user account used to authenticate.",
                        "Required": true,
                        "Type": "TypeString"
                    }
                },
                "Type": "TypeList"
            },
            "user_password": {
                "Description": "User password for Authentication.",
                "ExactlyOneOf": "auth_config.0.user_password, auth_config.0.oauth2_jwt_bearer, auth_config.0.oauth2_client_credentials, auth_config.0.ssh_public_key, auth_config.0.oauth2_auth_code_flow",
                "MaxItems": 1,
                "Optional": true,
                "Properties": {
                    "password": {
                        "Description": "Password for Authentication.",
                        "MaxItems": 1,
                        "Optional": true,
                        "Properties": {
                            "secret_version": {
                                "Description": "The resource name of the secret version in the format,\nformat as: projects/*/secrets/*/versions/*.",
                                "Required": true,
                                "Type": "TypeString"
                            }
                        },
                        "Type": "TypeList"
                    },
                    "username": {
                        "Description": "Username for Authentication.",
                        "Required": true,
                        "Type": "TypeString"
                    }
