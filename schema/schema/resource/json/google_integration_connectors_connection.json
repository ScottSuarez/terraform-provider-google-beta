                "Description": "Parameters to support Oauth 2.0 Auth Code Grant Authentication.",
                "ExactlyOneOf": "auth_config.0.user_password, auth_config.0.oauth2_jwt_bearer, auth_config.0.oauth2_client_credentials, auth_config.0.ssh_public_key, auth_config.0.oauth2_auth_code_flow",
