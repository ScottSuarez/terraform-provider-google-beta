                    },
                    "key": {
                        "Description": "Key for the configVariable",
                        "Required": true,
                        "Type": "TypeString"
                    },
                    "secret_value": {
                        "Description": "Secret value of configVariable.",
                        "MaxItems": 1,
                        "Optional": true,
                        "Properties": {
                            "secret_version": {
                                "Description": "Secret version of Secret Value for Config variable.",
                                "Required": true,
                                "Type": "TypeString"
                            }
